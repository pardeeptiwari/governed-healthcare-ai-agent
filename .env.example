# Copy to .env for reference, then export the values in your shell.
# Point to your external, reviewed assignment pack.
ASSIGNMENT_PACK=../assignment_source/T4_Lead_AI_Architect_A
MOCK_URL=http://127.0.0.1:8090
STATE_DB=state.sqlite
# Optional ISO date for deterministic tests. Default is the mock health clock.
EVALUATION_AS_OF=

# Replace placeholders locally. Never commit real credentials.
REP_CREDENTIALS_JSON='{"replace-with-rep-key-a":{"tenant":"plan_a","rep":"demo-a"},"replace-with-rep-key-b":{"tenant":"plan_b","rep":"demo-b"}}'
TENANT_TOKENS_JSON='{"plan_a":"replace-with-mock-token-a","plan_b":"replace-with-mock-token-b"}'
DIRECTORY_KEY=replace-with-directory-key

# Leave MODEL_URL unset for deterministic classification.
MODEL_URL=
MODEL_NAME=
MODEL_KEY=
MODEL_INPUT_PER_MILLION=0
MODEL_OUTPUT_PER_MILLION=0
CLAIM_SECONDS=3
